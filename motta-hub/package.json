{
  "name": "picpedia-catalog-local",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild app.tsx --bundle --minify --format=iife --target=es2022 --jsx=automatic --outfile=app.js --define:process.env.NODE_ENV=\"\\\"production\\\"\" --legal-comments=eof",
    "test:api": "python3 -m unittest -v test_server"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  }
}
